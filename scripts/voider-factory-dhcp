#!/bin/sh
# Factory lease handler: a private directly connected LAN, never an Internet route.
set -eu
[ "${interface:-}" = eth0 ] || exit 1

clear_address() {
    ip -4 addr flush dev eth0 scope global
    ip -4 route flush dev eth0
}

case "${1:-}" in
    deconfig|nak) clear_address ;;
    bound|renew)
        # Reject malformed/noncontiguous masks and leases extending outside the
        # private LAN ranges. Router, DNS and classless-route options are unused.
        cidr=$(awk -v address="${ip:-}" -v mask="${subnet:-}" 'BEGIN {
            if (split(address,a,".") != 4 || split(mask,m,".") != 4) exit 1
            prefix=0; zero=0
            for (i=1;i<=4;i++) {
                if (a[i] !~ /^[0-9]+$/ || a[i]>255 || m[i] !~ /^[0-9]+$/ || m[i]>255) exit 1
                for (bit=7;bit>=0;bit--) {
                    one=int(m[i]/(2^bit))%2
                    if (one) { if (zero) exit 1; prefix++ } else zero=1
                }
            }
            minimum=a[1]==10?8:(a[1]==172 && a[2]>=16 && a[2]<=31?12:(a[1]==192 && a[2]==168?16:33))
            if (prefix<minimum) exit 1
            print address "/" prefix
        }') || { clear_address; exit 1; }
        current=$(ip -4 -o addr show dev eth0 scope global | awk 'NR==1 {print $4}')
        [ "$current" = "$cidr" ] || clear_address
        ip -4 addr replace "$cidr" dev eth0
        ;;
esac
