#!/sbin/openrc-run
name="voider-wan"
description="voider-owned WAN DHCP/recovery monitor"
command="/usr/local/sbin/voider-wan"
command_args="monitor"
supervisor="supervise-daemon"
pidfile="/run/voider-wan.pid"
respawn_delay=2
respawn_max=5
respawn_period=60
retry="TERM/10/KILL/2"
output_log="/run/voider/wan.log"
error_log="$output_log"
healthcheck_delay=90
healthcheck_timer=20
depend(){
    need voider-appliance voider-firewall networking
    before tor
    before sshd
    before voider
    after voider-appliance
}

start_pre(){
    /usr/local/sbin/voider-appliance-boot gate || return 1
}

healthcheck(){
    /usr/local/sbin/voider-wan --healthcheck
}
