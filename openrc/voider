#!/sbin/openrc-run
name="voider"
description="Voider connection coordinator"
command="/usr/local/sbin/voider-peerd"
supervisor="supervise-daemon"
pidfile="/run/voider.pid"
respawn_delay=2
respawn_max=5
respawn_period=60
retry="TERM/20/KILL/5"
output_log="/run/voider/peerd-service.log"
error_log="$output_log"
healthcheck_delay=15
healthcheck_timer=10
depend() {
    need voider-appliance voider-firewall voider-wan voider-phone voider-nfqd
    after chronyd tor sshd
}
start_pre() {
    /usr/local/sbin/voider-appliance-boot gate
}
healthcheck() {
    /usr/local/sbin/voider-peerd --healthcheck
}
