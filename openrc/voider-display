#!/sbin/openrc-run

description="Voider physical display"
command="/usr/local/sbin/voider-ui"
command_args="--display --loop"
supervisor="supervise-daemon"
pidfile="/run/voider-display.pid"
respawn_delay=2
respawn_max=5
respawn_period=60
retry="TERM/5/KILL/2"
output_log="/run/voider/display.log"
error_log="$output_log"
healthcheck_delay=10
healthcheck_timer=10

depend() {
    need localmount voider-buttons
    before voider-appliance
}

start_pre() {
    mkdir -p /run/voider
    rm -f /run/voider/display-blank
    if ! /usr/local/sbin/voider-ui --display-probe >/run/voider/display-probe 2>&1; then
        eerror "No supported physical display; service must not run on this appliance"
        return 1
    fi
}

stop_post() {
    # Leave the mandatory panel black even when shutdown was initiated outside
    # the display menu. This is best effort because the framebuffer may already
    # be gone late in the OpenRC shutdown sequence.
    /usr/local/sbin/voider-ui --blank >/dev/null 2>&1 || true
}

healthcheck() {
    /usr/local/sbin/voider-ui --healthcheck
}
