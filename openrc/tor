#!/sbin/openrc-run
description="Voider Tor negotiation and fallback provider"
command="/usr/local/sbin/voider-tor"
command_args="-f /etc/tor/torrc --RunAsDaemon 0 --User tor"
supervisor="supervise-daemon"
pidfile="/run/voider-tor.pid"
respawn_delay=3
respawn_max=5
respawn_period=60
retry="TERM/10/KILL/2"
output_log="/run/voider/tor.log"
error_log="$output_log"
depend() {
    need voider-appliance voider-firewall voider-wan voider-tor-netns-socks chronyd
}
start_pre() {
    /usr/local/sbin/voider-appliance-boot gate || return 1
    /usr/bin/tor --verify-config -f /etc/tor/torrc --RunAsDaemon 0 --User tor
}
